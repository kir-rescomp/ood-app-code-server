---
cluster: "slurm"

attributes:
  cores:
    widget: "number_field"
    label: "Number of cores"
    help: How many CPU cores to reserve for your session. NB Ensure this is within the maximum allowed by your chosen partition.
    min: 1
    max: 8
    value: 2

  ram:
    widget: "number_field"
    label: "Memory (GB)"
    help: How much RAM to reserve for your session. NB Ensure this is within the maximum allowed by your chosen partition
    min: 1
    max: 176
    value: 4

  bc_num_hours:
    widget: "number_field"
    label: "Number of hours"
    min: 1
    max: 240
    value: 2
    cachable: true

  gpu_account:
    label: GPU Slurm account
    help: >
      Required for GPU partitions. Enter the Slurm account that has been
      granted GPU access (e.g. <code>gpu_yourgroup.prj</code>).
      CPU partitions do not need this — leave blank.
    widget: text_field
    required: false
    cachable: true

form:
  - auto_queues
  - gpu_account
  - cores
  - ram
  - bc_num_hours
